<div class="hero">
    <div class="hero-badge">Council Meeting Platform</div>
    <h1>Hackney Council<br>Meeting Scheduler</h1>
    <p>Schedule, stream, and archive council meetings in one place. Stay informed and engaged with your local government.</p>
    <div class="hero-actions">
        <% if (currentUser) { %>
            <a href="/schedule" class="btn">View Schedule</a>
            <a href="/live_stream" class="btn btn-ghost">Live Stream</a>
        <% } else { %>
            <a href="/register" class="btn">Get Started</a>
            <a href="/login" class="btn btn-ghost">Sign In</a>
        <% } %>
    </div>

    <div class="feature-grid">
        <div class="feature-card">
            <span class="feature-icon">📅</span>
            <h3>Meeting Scheduling</h3>
            <p>Create and manage council meetings with agendas and supporting documents.</p>
        </div>
        <div class="feature-card">
            <span class="feature-icon">📡</span>
            <h3>Live Streaming</h3>
            <p>Broadcast meetings in real-time and engage with live comments.</p>
        </div>
        <div class="feature-card">
            <span class="feature-icon">🗄️</span>
            <h3>Meeting Archive</h3>
            <p>Access recordings and minutes from past council meetings.</p>
        </div>
        <div class="feature-card">
            <span class="feature-icon">🔐</span>
            <h3>Role-based Access</h3>
            <p>Admin and regular user roles with appropriate permissions.</p>
        </div>
    </div>
</div>
