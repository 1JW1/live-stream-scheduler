<div class="page-header">
    <h2>Admin Panel</h2>
    <span class="badge badge-role">Admin</span>
</div>

<div style="display:grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start;">

    <!-- Add Meeting Form -->
    <div class="card">
        <div class="card-title">Schedule a New Meeting</div>
        <form method="POST" action="/admin" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="form-group">
                <label for="date">Meeting Date</label>
                <input type="date" id="date" name="date">
                <% if (typeof errors !== 'undefined') { %>
                    <% for (const e of errors.filter(e => e.path === 'date')) { %>
                        <span class="text-danger"><%= e.msg %></span>
                    <% } %>
                <% } %>
            </div>

            <div class="form-group">
                <label for="agenda">Meeting Agenda</label>
                <input type="text" id="agenda" name="agenda" placeholder="Brief description of the meeting agenda">
                <% if (typeof errors !== 'undefined') { %>
                    <% for (const e of errors.filter(e => e.path === 'agenda')) { %>
                        <span class="text-danger"><%= e.msg %></span>
                    <% } %>
                <% } %>
            </div>

            <div class="form-group">
                <label for="documents">Upload Documents (optional)</label>
                <input type="file" id="documents" name="documents">
            </div>

            <button type="submit" class="btn">Add Meeting</button>
        </form>
    </div>

    <!-- Existing Meetings -->
    <div>
        <h3 style="margin-bottom: 1rem;">Existing Meetings</h3>
        <% if (meetings && meetings.length > 0) { %>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Agenda</th>
                            <th>Doc</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (const meeting of meetings) { %>
                        <tr>
                            <td style="white-space:nowrap;"><%= new Date(meeting.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                            <td><%= meeting.agenda %></td>
                            <td>
                                <% if (meeting.documents) { %>
                                    <a href="/uploads/<%= meeting.documents %>">View</a>
                                <% } else { %>
                                    <span style="color:var(--text-muted);">—</span>
                                <% } %>
                            </td>
                            <td>
                                <form method="POST" action="/admin/delete/<%= meeting.id %>"
                                      onsubmit="return confirm('Delete this meeting?');">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="empty-state">
                <span class="empty-icon">📋</span>
                <p>No meetings yet. Add one using the form.</p>
            </div>
        <% } %>
    </div>

</div>
