<div class="page-header">
    <h2>Meeting Archive</h2>
</div>

<% if (archivedMeetings && archivedMeetings.length > 0) { %>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Video Recording</th>
                    <th>Minutes</th>
                </tr>
            </thead>
            <tbody>
                <% for (const meeting of archivedMeetings) { %>
                <tr>
                    <td><%= new Date(meeting.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' }) %></td>
                    <td>
                        <a href="/static/<%= meeting.video_path %>" class="btn btn-sm btn-ghost">
                            Watch Video
                        </a>
                    </td>
                    <td>
                        <a href="/static/<%= meeting.minutes_path %>" class="btn btn-sm btn-ghost">
                            Download Minutes
                        </a>
                    </td>
                </tr>
                <% } %>
            </tbody>
        </table>
    </div>
<% } else { %>
    <div class="empty-state">
        <span class="empty-icon">🗄️</span>
        <p>No archived meetings available yet.</p>
    </div>
<% } %>
